HOSTNAME=http://localhost:8080
# Signs session cookies: openssl rand -base64 32
SESSION_SECRET=change-me
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# Optional: variables for destination templates, as {{.Vars.NAME}}.
# CATCHY_VAR_to=team@example.com

# Secrets guards and destinations use by name, e.g. {{.Secrets.RESEND_API_KEY}};
# usually set by a secret manager.
# CATCHY_SECRET_RESEND_API_KEY=re_...
# CATCHY_SECRET_STRIPE_WEBHOOK_SECRET=whsec_...
